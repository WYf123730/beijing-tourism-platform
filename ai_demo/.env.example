# 复制为 .env 后填入自己的 key（.env 不会提交到仓库）

# DeepSeek 官方（OpenAI 兼容）：https://api.deepseek.com/v1
# 其他可选，都是 OpenAI 兼容协议，只改这三行即可：
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4        glm-4-flash（永久免费）
#   硅基流动   https://api.siliconflow.cn/v1               Qwen/Qwen2.5-7B-Instruct
#   阿里百炼   https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-turbo

DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
